---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import { getDictionary, homePath } from "@/i18n/utils";
import type { Locale } from "@/data/types";

const locale: Locale = "es";
const dictionary = getDictionary(locale);
---

<BaseLayout locale={locale} dictionary={{ ...dictionary, meta: { title: dictionary.notFound.title, description: dictionary.notFound.text } }}>
  <Header locale={locale} nav={dictionary.nav} />
  <main class="container flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="mb-4 font-mono text-sm font-bold text-accent">{dictionary.notFound.heading}</p>
    <p class="mb-8 max-w-md text-lg text-muted-darker">{dictionary.notFound.text}</p>
    <div class="flex gap-3">
      <a href={homePath[locale]} class="rounded-sm bg-ink px-6 py-3 text-sm font-semibold text-cream">
        {dictionary.notFound.home}
      </a>
    </div>
  </main>
  <Footer footer={dictionary.footer} />
</BaseLayout>
