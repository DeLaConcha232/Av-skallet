---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Hero from "@/components/astro/Hero.astro";
import PainPoints from "@/components/astro/PainPoints.astro";
import Services from "@/components/astro/Services.astro";
import Process from "@/components/astro/Process.astro";
import TechStandards from "@/components/astro/TechStandards.astro";
import DifferentiatorQuote from "@/components/astro/DifferentiatorQuote.astro";
import Work from "@/components/astro/Work.astro";
import Plans from "@/components/astro/Plans.astro";
import Faq from "@/components/astro/Faq.astro";
import Contact from "@/components/astro/Contact.astro";
import Footer from "@/components/astro/Footer.astro";
import WhatsAppFloat from "@/components/astro/WhatsAppFloat.astro";
import { getDictionary } from "@/i18n/utils";
import { work } from "@/data/work";
import { plans } from "@/data/plans";
import { faq } from "@/data/faq";
import type { Locale } from "@/data/types";

const locale: Locale = "en";
const dictionary = getDictionary(locale);
---

<BaseLayout locale={locale} dictionary={dictionary}>
  <Header locale={locale} nav={dictionary.nav} />
  <main>
    <Hero hero={dictionary.hero} />
    <PainPoints problem={dictionary.problem} />
    <Services services={dictionary.services} />
    <Process process={dictionary.process} />
    <TechStandards tech={dictionary.tech} />
    <DifferentiatorQuote diff={dictionary.diff} />
    <Work work={dictionary.work} items={work[locale]} />
    <Plans plans={dictionary.plans} items={plans[locale]} />
    <Faq heading={dictionary.faqHeading} items={faq[locale]} />
    <Contact locale={locale} contact={dictionary.contact} />
  </main>
  <Footer footer={dictionary.footer} />
  <WhatsAppFloat locale={locale} label={dictionary.contact.whatsapp} />
</BaseLayout>
