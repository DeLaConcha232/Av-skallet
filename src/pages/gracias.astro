---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import { getDictionary, homePath } from "@/i18n/utils";
import type { Locale } from "@/data/types";

const locale: Locale = "es";
const dictionary = getDictionary(locale);
---

<BaseLayout locale={locale} dictionary={{ ...dictionary, meta: { title: dictionary.thanks.title, description: dictionary.thanks.text } }}>
  <Header locale={locale} nav={dictionary.nav} />
  <main class="container flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <h1 class="mb-4 text-3xl font-extrabold text-ink">{dictionary.thanks.heading}</h1>
    <p class="mb-8 max-w-md text-lg text-muted-darker">{dictionary.thanks.text}</p>
    <a href={homePath[locale]} class="rounded-sm bg-ink px-6 py-3 text-sm font-semibold text-cream">
      {dictionary.thanks.back}
    </a>
  </main>
  <Footer footer={dictionary.footer} />
</BaseLayout>
