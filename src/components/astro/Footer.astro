---
import type { FooterDictionary } from "@/data/types";
import { site } from "@/data/site";
import { Mail } from "lucide-react";
import logoMark from "@/assets/logo/avskallet-mark.svg?raw";

interface Props {
  footer: FooterDictionary;
}

const { footer } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container flex flex-wrap items-center justify-between gap-4 py-8">
    <div class="flex items-center gap-3 text-muted">
      <span class="h-[18px] w-[18px] text-muted [&>svg]:h-full" set:html={logoMark} />
      <span class="text-sm">{footer.tagline}</span>
      <div class="ml-2 flex items-center gap-1">
        <a href={`mailto:${site.email}`} aria-label="Email" class="p-1.5 text-muted transition-colors hover:text-accent">
          <Mail className="h-4 w-4" />
        </a>
      </div>
    </div>
    <span class="text-[13px] text-muted-light">© {year} {site.name}. {footer.rights}</span>
  </div>
</footer>
