---
import type { ServicesDictionary } from "@/data/types";
import { shapeClass } from "@/lib/shapes";

interface Props {
  services: ServicesDictionary;
}

const { services } = Astro.props;
---

<section id="servicios" class="bg-ink py-16 md:py-20">
  <div class="container">
    <div class="mb-10 flex flex-wrap items-baseline justify-between gap-5">
      <div>
        <div class="mb-4 h-1.5 w-9 bg-accent"></div>
        <h2 class="text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-cream">
          {services.heading}
        </h2>
      </div>
      <p class="max-w-sm text-sm text-muted-light">{services.sub}</p>
    </div>

    <div class="grid grid-cols-1 gap-px border border-border-dark bg-border-dark sm:grid-cols-2 lg:grid-cols-4">
      {services.items.map((svc, i) => (
        <div class:list={["flex min-h-[220px] flex-col justify-between p-7", i % 2 === 0 ? "bg-ink-soft" : "bg-ink"]}>
          <div class:list={["h-[18px] w-[18px] bg-accent", shapeClass[i % shapeClass.length]]}></div>
          <div>
            <h3 class="mb-2.5 text-xl font-bold text-cream">{svc.title}</h3>
            <p class="text-[15px] leading-relaxed text-muted-light">{svc.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
