---
import type { Locale } from "@/data/types";
import { whatsappHref } from "@/data/site";
import { MessageCircle } from "lucide-react";

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<a
  href={whatsappHref(locale)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-accent text-accent-ink shadow-lg transition-transform hover:scale-110"
>
  <MessageCircle className="h-7 w-7" />
</a>
