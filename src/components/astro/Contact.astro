---
import type { ContactDictionary, Locale } from "@/data/types";
import { whatsappHref } from "@/data/site";

interface Props {
  locale: Locale;
  contact: ContactDictionary;
}

const { locale, contact } = Astro.props;
---

<section id="contacto" class="container max-w-2xl py-16 md:py-24">
  <div class="mb-4 h-1.5 w-9 bg-accent"></div>
  <h2 class="mb-4 text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-ink">
    {contact.heading}
  </h2>
  <p class="mb-8 max-w-lg text-lg leading-relaxed text-muted-darker">{contact.sub}</p>
  <a
    href={whatsappHref(locale)}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-2.5 rounded-sm bg-ink px-8 py-4 text-base font-semibold text-cream transition-colors hover:bg-ink-soft"
  >
    {contact.whatsapp}
  </a>
</section>
