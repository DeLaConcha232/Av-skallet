---
import type { ProblemDictionary } from "@/data/types";

interface Props {
  problem: ProblemDictionary;
}

const { problem } = Astro.props;
---

<section class="container max-w-4xl border-t border-border py-16 md:py-20">
  <div class="mb-4 h-1.5 w-9 bg-accent"></div>
  <h2 class="mb-8 max-w-xl text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-ink">
    {problem.heading}
  </h2>

  <div class="mb-10 grid grid-cols-1 gap-7 sm:grid-cols-3">
    {problem.pains.map((pain) => (
      <div>
        <div class="mb-2.5 font-mono text-xs text-accent">{pain.tag}</div>
        <p class="text-base leading-relaxed text-ink-soft">{pain.text}</p>
      </div>
    ))}
  </div>

  <div class="border-t border-border pt-8">
    <p class="max-w-2xl text-xl font-semibold leading-relaxed text-ink">{problem.closing}</p>
  </div>
</section>
