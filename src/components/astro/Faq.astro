---
import type { FaqItem } from "@/data/types";

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

<section id="faq" class="container max-w-3xl border-t border-border py-16 md:py-20">
  <div class="mb-4 h-1.5 w-9 bg-accent"></div>
  <h2 class="mb-9 text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-ink">
    {heading}
  </h2>

  <div class="flex flex-col">
    {items.map((item) => (
      <details class="group border-b border-border py-1 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-base font-semibold text-ink">
          <span>{item.q}</span>
          <span class="shrink-0 font-mono text-lg text-accent">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">–</span>
          </span>
        </summary>
        <p class="max-w-xl pb-5 text-[15px] leading-relaxed text-muted-dark">{item.a}</p>
      </details>
    ))}
  </div>
</section>
