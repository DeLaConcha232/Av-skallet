---
import type { TechDictionary } from "@/data/types";

interface Props {
  tech: TechDictionary;
}

const { tech } = Astro.props;

const shapeClass = [
  "rounded-none",
  "rounded-full",
  "rounded-none rotate-45",
  "rounded-none [clip-path:polygon(50%_0%,0%_100%,100%_100%)]",
  "rounded-full [clip-path:polygon(0%_0%,100%_0%,100%_100%)]",
];
---

<section class="container border-t border-border py-16 md:py-20">
  <div class="mb-10 max-w-xl">
    <div class="mb-4 h-1.5 w-9 bg-accent"></div>
    <h2 class="mb-3.5 text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-ink">
      {tech.heading}
    </h2>
    <p class="text-[15px] leading-relaxed text-muted">{tech.sub}</p>
  </div>

  <div class="grid grid-cols-1 gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
    {tech.items.map((item, i) => (
      <div class="flex min-h-[170px] flex-col gap-3.5 bg-cream p-6">
        <div class:list={["h-4 w-4 bg-accent", shapeClass[i % shapeClass.length]]}></div>
        <h3 class="text-base font-bold text-ink">{item.title}</h3>
        <p class="text-sm leading-relaxed text-muted-dark">{item.desc}</p>
      </div>
    ))}
  </div>
</section>
