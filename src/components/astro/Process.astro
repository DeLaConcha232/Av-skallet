---
import type { ProcessDictionary } from "@/data/types";

interface Props {
  process: ProcessDictionary;
}

const { process: proc } = Astro.props;
---

<section id="proceso" class="container max-w-4xl border-t border-border py-16 md:py-20">
  <div class="mb-4 h-1.5 w-9 bg-accent"></div>
  <h2 class="mb-10 text-[clamp(1.6rem,3.4vw,2.25rem)] font-extrabold tracking-tight text-ink">
    {proc.heading}
  </h2>

  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {proc.steps.map((step) => (
      <div class="border-t-2 border-accent pt-4">
        <div class="mb-3 font-mono text-xs font-bold text-accent">{step.n}</div>
        <h3 class="mb-2 text-[17px] font-bold text-ink">{step.title}</h3>
        <p class="text-sm leading-relaxed text-muted-dark">{step.desc}</p>
      </div>
    ))}
  </div>
</section>
